# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
# CRITICAL: Both localhost (.env.local) and Vercel env vars must point to the
# SAME project. Mismatched projects = empty data in production.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://foundery.space
NEXT_PUBLIC_APP_BASE_URL=https://foundery.space

# ─── Optional features ────────────────────────────────────────────────────────
# AI search (Kimi K2 via custom endpoint)
LLM_API_KEY=

# Groq fallback for AI search
GROQ_API_KEY=

# Admin dashboard protection
ADMIN_TOKEN=

# Firecrawl for admin opportunity import
FIRECRAWL_API_KEY=

# Cloudinary for logo uploads
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Search mode: "ai" (default) or "text"
NEXT_PUBLIC_SEARCH_MODE=ai
