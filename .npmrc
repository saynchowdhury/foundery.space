shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
link-workspace-packages=false
node-linker=hoisted

# Allow native build scripts required for Next.js image optimization and bundling
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=@img/sharp-libvips-linuxmusl-arm64
onlyBuiltDependencies[]=@img/sharp-libvips-linuxmusl-x64
onlyBuiltDependencies[]=@img/sharp-libvips-linux-arm64
onlyBuiltDependencies[]=@img/sharp-libvips-linux-s390x
onlyBuiltDependencies[]=@img/sharp-libvips-linux-ppc64
onlyBuiltDependencies[]=@img/sharp-libvips-darwin-x64
onlyBuiltDependencies[]=@img/sharp-libvips-darwin-arm64
onlyBuiltDependencies[]=@img/sharp-libvips-linux-arm
onlyBuiltDependencies[]=@img/sharp-win32-x64
onlyBuiltDependencies[]=@img/sharp-win32-arm64
onlyBuiltDependencies[]=@img/sharp-win32-ia32
onlyBuiltDependencies[]=unrs-resolver
